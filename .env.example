# Supabase Dashboard > Project Settings > API / API Keys.
# Public values are included in the browser bundle; safe only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required for secure order creation; server only (never NEXT_PUBLIC_).
# Use a Supabase secret key, or the legacy service_role key.
# Never add this key to browser code or commit .env.local.
SUPABASE_SECRET_KEY=
